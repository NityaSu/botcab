# Example env for local Docker / cloud. Copy to `.env` — never commit secrets.
# Host JVM defaults still work without this file (see application.yml).

# Local / Compose. On Railway/Render, omit this — the platform sets PORT.
SERVER_PORT=8080

# Postgres (Compose service name is "postgres")
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/botcab
SPRING_DATASOURCE_USERNAME=botcab
SPRING_DATASOURCE_PASSWORD=botcab

# Redis (inside Compose: host redis, port 6379)
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=

# Optional JVM flags in the container
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0
